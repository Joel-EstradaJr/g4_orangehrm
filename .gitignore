# Generated config after installation
lib/confs/Conf.php

# Doctrine caches
src/cache/doctrine_metadata/
src/cache/doctrine_queries/

# OrangeHRM caches
src/cache/orangehrm/

# Installer logs
src/log/installer.log
src/log/orangehrm.log

# Node.js dependencies (ignore everywhere)
node_modules/

# Yarn v2+ cache & unpacked dependencies
**/.yarn/cache/
**/.yarn/unplugged/
**/.yarn/build-state.yml
**/.pnp.*

# Keep these Yarn files
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/patches/
!.yarn/install-state.gz

# Frontend build output
web/dist/

# PHP Composer vendor dir (already committed in this project under src/vendor; keep lockfile)
# If switching to a clean vendor install flow, uncomment the next line:
src/vendor/

# Local composer artifacts
src/composer.phar
src/vendor/composer/installed.json

# Frontend logs and local env
**/yarn-error.log
**/npm-debug.log*
src/client/.env.local
src/client/.env.*.local

# Test coverage (client)
src/client/coverage/

# Leave Assistant local overrides (do not commit developer-specific FAQ tweaks)
plugins/orangehrmLeavePlugin/config/assistant-faq.local.yaml
